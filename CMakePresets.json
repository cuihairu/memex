{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "开发构建（Release · 服务端+客户端+测试）",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MEMEX_BUILD_CLIENT": "ON",
        "VCPKG_MANIFEST_FEATURES": "server;client;crashpad"
      }
    },
    {
      "name": "server-release",
      "inherits": "base",
      "displayName": "服务端 Release（nightly 产物）",
      "binaryDir": "${sourceDir}/build-server",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MEMEX_BUILD_CLIENT": "OFF",
        "MEMEX_BUILD_TESTS": "OFF",
        "VCPKG_MANIFEST_FEATURES": "server",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-server"
      }
    },
    {
      "name": "client-release",
      "inherits": "base",
      "displayName": "客户端 Release（nightly 产物）",
      "binaryDir": "${sourceDir}/build-client",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MEMEX_BUILD_CLIENT": "ON",
        "MEMEX_BUILD_SERVER": "OFF",
        "MEMEX_BUILD_TESTS": "OFF",
        "VCPKG_MANIFEST_FEATURES": "client;crashpad"
      }
    },
    {
      "name": "client-release-win",
      "inherits": "client-release",
      "displayName": "客户端 Release（Windows x64：官方 Qt + vcpkg 非 Qt 依赖）",
      "binaryDir": "${sourceDir}/build-client-win",
      "cacheVariables": {
        "MEMEX_BUILD_SERVER": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_FEATURES": "crashpad",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-win"
      }
    },
    {
      "name": "client-release-mac",
      "inherits": "client-release",
      "displayName": "客户端 Release（macOS arm64：官方 Qt + vcpkg 静态非 Qt 依赖）",
      "binaryDir": "${sourceDir}/build-client-mac",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_MANIFEST_FEATURES": "crashpad",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-mac"
      }
    },
    {
      "name": "server-release-mac",
      "inherits": "server-release",
      "displayName": "服务端 Release（macOS arm64：vcpkg 静态依赖，单二进制分发）",
      "binaryDir": "${sourceDir}/build-server-mac",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed-mac-server"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "CI 门禁（Debug+覆盖率 · 服务端+客户端+测试）",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MEMEX_BUILD_CLIENT": "ON",
        "VCPKG_MANIFEST_FEATURES": "server;client;crashpad",
        "CMAKE_CXX_FLAGS": "--coverage"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "server-release",
      "configurePreset": "server-release"
    },
    {
      "name": "client-release",
      "configurePreset": "client-release"
    },
    {
      "name": "client-release-win",
      "configurePreset": "client-release-win"
    },
    {
      "name": "client-release-mac",
      "configurePreset": "client-release-mac"
    },
    {
      "name": "server-release-mac",
      "configurePreset": "server-release-mac"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
