# memex 企业目录认证（LDAP/AD）示例配置 —— 544
#
# 用法（二选一，旗标优先于环境变量）：
#   旗标：memex_server serve --ldap-host ... （完整旗标见本文件下方注释与
#         docs「企业目录认证（LDAP/AD）」节）
#   环境：source 本文件后启动（本文件只含环境变量赋值，可直接 source）
#
# 红线口径（实现见 server/src/ldap.hpp 头注，此处只列使用者须知的）：
# - 默认全关：不配 --ldap-host/MEMEX_LDAP_HOST 时零 LDAP 路径，服务端行为
#   与未启用版逐字节一致；本地账号（平台-2 口令）常备，是独立信任模型。
# - 组→角色只认下方显式映射表：表为空＝认证通过也不授任何角色（人人普通
#   成员）；表里不写 admin 就永不授管理员——目录管理员组不会隐式提权。
# - 目录不可用＝登录失败（fail-closed），绝不静默回落本地口令；绑定 issuer
#   =ldap 的账号在目录挂掉时宁可全员拒登。
# - 目录侧禁用：新登录直接拒；已在线会话默认踢下线（可关，见下方
#   KICK_DISABLED）。
# - 口令只在 bind 报文里走一次：不落盘、不进日志、不进审计正文（审计只记
#   谁/何时/方式/成败）。

# —— 必配：目录地址与用户定位 ——
export MEMEX_LDAP_HOST=ad.corp.example.com
# 端口默认 389（ldaps 用 636；旗标 --ldap-port，无同名环境变量）
# export MEMEX_LDAP_PORT=389
export MEMEX_LDAP_USER_BASE=ou=people,dc=corp,dc=example,dc=com
# 用户名匹配属性：OpenLDAP 常用 uid，AD 常用 sAMAccountName
export MEMEX_LDAP_USER_ATTR=sAMAccountName

# —— 必配二选一：绑定路径 ——
# ① 服务账号先查后绑（AD 常用：DN 拼不出，须先查）。
#    口令建议走环境变量注入（不进 shell 历史/ps），配置文件须 0600。
export MEMEX_LDAP_BIND_DN=cn=svc-memex,ou=svc,dc=corp,dc=example,dc=com
export MEMEX_LDAP_BIND_PASSWORD='changeme-service-account'
# ② 模板直绑（OpenLDAP 常用，无服务账号；{u} 替换为用户名）：
# export MEMEX_LDAP_BIND_DN_TEMPLATE='uid={u},ou=people,dc=corp,dc=example,dc=com'
#    注意：模板模式无服务凭据，「存量会话禁用踢下线」查不了（启动会明示
#    该策略不生效），新登录拒不受影响。

# —— TLS 姿态（三态恰一，默认拒绝明文 bind）——
# 推荐 StartTLS：明连 389 后升级 TLS（AD/OpenLDAP 常态）。旗标 --ldap-starttls
# 或 ldaps 整连接 --ldap-ssl（636）。
# 自签证书：--ldap-tls-insecure 跳过校验（启动打警告；仅限受控内网）。
# 实在无 TLS：--ldap-allow-plain 明文放行（启动打警告；仅限测试/隔离网段）。

# —— 组→角色显式映射（可重复；环境变量逗号分隔多条）——
# 格式：组DN=角色名（组名大小写不敏感）。目录条目的 memberOf 属性比对
# （AD 标配；OpenLDAP 需 memberof overlay，属性名可用
# --ldap-memberof-attr 改）。
# 表为空＝不做任何自动授权；表里别写 admin，除非你真的要目录组授管理员。
export MEMEX_LDAP_GROUP_ROLE='cn=memex-viewers,ou=groups,dc=corp,dc=example,dc=com=viewer,cn=memex-operators,ou=groups,dc=corp,dc=example,dc=com=operator'

# —— 目录禁用检测（可选；AD 停用位三元组如下）——
# 旗标 --ldap-disabled-attr/--ldap-disabled-rule/--ldap-disabled-value
# AD：userAccountControl & 0x2（1.2.840.113556.1.4.803 是 OID 匹配规则）
#   --ldap-disabled-attr userAccountControl
#   --ldap-disabled-rule 1.2.840.113556.1.4.803
#   --ldap-disabled-value 2
# OpenLDAP 常用：--ldap-disabled-attr pwdAccountLockedTime（值 0000010100Z）

# —— 首登策略（默认全关＝显式绑定口径）——
# 已有本地账号无绑定时，目录认证成功即自动 identity_bind：--ldap-auto-bind
# 账号不存在时，目录认证成功即建影子账号（本地口令随机不可知＝仅目录可登）：
# --ldap-auto-provision
# 都不开＝只有管理员用 `memex_server identity bind` 显式绑定的账号走目录
# 判登，其余账号照走本地口令。

# —— 存量会话禁用策略 ——
# 默认踢下线、60s 复检。旗标：--ldap-kick-disabled 0 关踢；--ldap-recheck-seconds N 调间隔。
