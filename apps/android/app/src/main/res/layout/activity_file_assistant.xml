<?xml version="1.0" encoding="utf-8"?>
<!--
  文件助手（R23-3 块3）：连接面板（同源账号换文件面 token）＋
  收件箱/个人空间混排列表 ＋ 备忘录快记行 ＋ 上传入口。
  交互语义对齐桌面文件助手面板；布局沿用传统 View 体系。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/files_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 连接面板：文件面端口独立于消息面（缺省 24561），口令不落盘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/et_files_account"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_account_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/et_files_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_password_hint"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/et_files_port"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="@string/files_port_hint"
            android:inputType="number"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_files_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_connect" />
    </LinearLayout>

    <!-- 外网模式（R23-4）：单向上传（唯一落点=文件助手收件箱），
         功能刻意做少（登录→传文件→看自己记录）；端口=部署明示的外网口 -->
    <CheckBox
        android:id="@+id/cb_uplink_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/files_uplink_mode" />

    <TextView
        android:id="@+id/tv_files_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/error_text"
        android:visibility="gone" />

    <!-- 读面切换：收件箱（手机发自己）／个人空间（target=me 隔离） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btn_tab_inbox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_tab_inbox" />

        <Button
            android:id="@+id/btn_tab_me"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_tab_me" />

        <Button
            android:id="@+id/btn_files_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_refresh" />
    </LinearLayout>

    <!-- 备忘录快记行：建/改共用一条（长按列表项改/删）；外网模式隐藏
         （外网面无备忘录端点） -->
    <LinearLayout
        android:id="@+id/ll_memo_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/et_memo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_memo_hint"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/btn_memo_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_memo_save" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btn_files_upload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_upload" />

        <TextView
            android:id="@+id/tv_files_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/files_state_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_files_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/files_empty"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lv_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ProgressBar
        android:id="@+id/pb_files"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />
</LinearLayout>
