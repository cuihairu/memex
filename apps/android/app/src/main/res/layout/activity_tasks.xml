<?xml version="1.0" encoding="utf-8"?>
<!--
  任务清单（R27-6）：连接面板＋列表视图／看板视图（同一批任务数据的
  另一视图，可切换）＋录入区（标题/类型/开始/截止/分配给）＋提醒开关行。
  端点/语义对齐桌面 TaskDialog；布局沿用传统 View 体系。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/tasks_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 连接面板：文件面端口独立（缺省 24561 同文件助手） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/et_tasks_account"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_account_hint"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/et_tasks_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/files_password_hint"
            android:inputType="textPassword"
            android:maxLines="1" />

        <EditText
            android:id="@+id/et_tasks_port"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="@string/files_port_hint"
            android:inputType="number"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_tasks_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_connect" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tasks_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/error_text"
        android:visibility="gone" />

    <!-- 录入区：标题＋类型＋分配给 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <EditText
            android:id="@+id/et_task_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/tasks_title_hint"
            android:inputType="text"
            android:maxLines="1" />

        <Spinner
            android:id="@+id/sp_task_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="96dp" />

        <EditText
            android:id="@+id/et_task_assignee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/tasks_assignee_hint"
            android:inputType="text"
            android:maxLines="1"
            android:minWidth="96dp" />
    </LinearLayout>

    <!-- 截止（deadline）＋开始（勾选才生效，0=未设） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/tasks_deadline_label" />

        <EditText
            android:id="@+id/et_task_due"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/tasks_ms_hint"
            android:inputType="number"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/cb_task_start_on"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tasks_start_label" />

        <EditText
            android:id="@+id/et_task_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:hint="@string/tasks_ms_hint"
            android:inputType="number"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 提醒开关（同一处）：开始到点提醒＋截止到期提醒，默认开 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <CheckBox
            android:id="@+id/cb_task_remind_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tasks_remind_start" />

        <CheckBox
            android:id="@+id/cb_task_remind_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/tasks_remind_due" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <Button
            android:id="@+id/btn_task_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/tasks_add" />

        <Button
            android:id="@+id/btn_task_board"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tasks_board" />

        <Button
            android:id="@+id/btn_tasks_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/files_refresh" />

        <TextView
            android:id="@+id/tv_tasks_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/files_state_off" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="@string/tasks_empty"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 列表视图（默认；窄屏看板自动降级回此视图） -->
    <ListView
        android:id="@+id/lv_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 看板（R27-6）：同一批任务数据的另一视图，横滑三列（待办/进行中/
         完成），默认隐藏 -->
    <HorizontalScrollView
        android:id="@+id/hs_tasks_board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/tasks_col_todo"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/lv_board_todo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/tasks_col_doing"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/lv_board_doing"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/tasks_col_done"
                    android:textStyle="bold" />

                <ListView
                    android:id="@+id/lv_board_done"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/pb_tasks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />
</LinearLayout>
