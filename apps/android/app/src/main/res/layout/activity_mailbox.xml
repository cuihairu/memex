<?xml version="1.0" encoding="utf-8"?>
<!--
  邮箱·移动端（原型 mobile-mailbox 屏①）：appbar（标题＋未读徽章）＋连接
  面板（文件面 24561，与文件助手同模板）＋chips 行（全部/告警/通知/公告
  ＋只看未读）＋条目列表＋底部 tabbar（会话/邮箱/任务/我）；详情抽屉为
  布局内底部面板（无 material，不用 BottomSheetDialog）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f7f5f2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- appbar：标题＋未读徽章（counts.all 为唯一来源） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/mbx_back"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="4dp"
                android:text="@string/chat_back"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/mbx_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mbx_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:minWidth="18dp"
                android:gravity="center"
                android:background="@drawable/mbx_badge"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 连接面板（文件面；账号预填协作登录账号，口令不落盘） -->
        <LinearLayout
            android:id="@+id/mbx_conn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="6dp"
            android:padding="12dp"
            android:background="@drawable/mbx_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/mbx_account"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/files_account_hint"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/mbx_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:hint="@string/files_password_hint"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/mbx_port"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:hint="@string/files_port_hint"
                    android:inputType="number"
                    android:maxLines="1"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/mbx_connect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/files_connect"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mbx_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/files_state_off"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/mbx_conn_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- chips：全部/告警/通知/公告（互斥）＋只看未读（toggle，右贴） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mbx_chip_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/mbx_chip_on"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mbx_chip_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/mbx_chip"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/mbx_chip_notice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/mbx_chip"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/mbx_chip_announce"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/mbx_chip"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/mbx_chip_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:background="@drawable/mbx_chip"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ListView
            android:id="@+id/mbx_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/mbx_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/mbx_empty"
            android:textColor="@color/text_tertiary"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <!-- tabbar（会话/邮箱/任务/我，邮箱高亮） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/mbx_tab_sessions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/nav_sessions"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/mbx_tab_mailbox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/mbx_title"
                android:textColor="@color/brand_orange"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mbx_tab_tasks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/mbx_tabbar_tasks"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/mbx_tab_me"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/nav_me"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 详情抽屉：dim scrim＋底部面板（点击 scrim 关闭） -->
    <FrameLayout
        android:id="@+id/mbx_sheet_wrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/mbx_sheet_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom">

            <include layout="@layout/view_mailbox_sheet" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
